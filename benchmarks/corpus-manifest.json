{
  "version": 1,
  "status": "frozen-slice-contract",
  "note": "This defines selection and weighting before the reproducible corpus is populated; it is not candidate result data.",
  "required_record_fields": [
    "id",
    "nar_size_bytes",
    "file_count",
    "directory_count",
    "symlink_count",
    "executable_count",
    "unique_content_bytes",
    "max_depth",
    "unusual_name_count"
  ],
  "slices": [
    {"name": "many-small-files", "selector": "file_count >= 10000 AND nar_size_bytes / file_count <= 4096", "weight_percent": 16.6666667},
    {"name": "shared-subtrees", "selector": "unique_content_bytes / nar_size_bytes <= 0.50 AND directory_count >= 100", "weight_percent": 16.6666667},
    {"name": "duplicate-content", "selector": "unique_content_bytes / nar_size_bytes <= 0.25", "weight_percent": 16.6666667},
    {"name": "large-contents", "selector": "nar_size_bytes >= 1073741824 AND file_count <= 1000", "weight_percent": 16.6666667},
    {"name": "symlink-and-executable", "selector": "symlink_count >= 10 AND executable_count >= 10", "weight_percent": 16.6666667},
    {"name": "deep-and-irregular-names", "selector": "max_depth >= 32 AND unusual_name_count >= 10", "weight_percent": 16.6666667}
  ],
  "aggregation": {
    "per_slice_metric": "median over the slice's measured roots",
    "overall_metric": "weighted median of slice medians",
    "improvement_required_percent": 15,
    "regression_limit_percent": 5,
    "minimum_slices_improved": 4
  }
}
