{
  "version": 4,
  "supersedes_version": 3,
  "frozen_on": "2026-09-05",
  "change_reason": "Require observed wire compression in provenance after the flat control exposed an unmatched external comparator; thresholds are unchanged and no semantic candidate has been measured.",
  "repetitions": 15,
  "warmup": 3,
  "wire_compression": "none",
  "primary_savings_gate_percent": {"reject_below": 25, "strong_at_or_above": 50},
  "matched_baseline": "raw NAR with transparent filesystem compression",
  "provenance_required_fields": [
    "commit",
    "binary_identity",
    "closure_identity",
    "host",
    "target",
    "kernel",
    "filesystem",
    "governor",
    "nix_version",
    "rust_version",
    "tool_versions",
    "command_log",
    "wire_compression",
    "corpus_manifest",
    "corpus_category",
    "cache_state",
    "warmups",
    "repetitions",
    "raw_samples"
  ],
  "metric_required_fields": ["savings_percent", "median", "p95", "unit"],
  "corpus_manifest": "benchmarks/corpus-manifest.json",
  "corpus_categories": [
    "many-small-files",
    "shared-subtrees",
    "duplicate-content",
    "large-contents",
    "symlink-and-executable",
    "deep-and-irregular-names"
  ],
  "hard_gates": {
    "ingest_wall_ratio_max": 1.5,
    "ingest_cpu_per_gib_ratio_max": 3.0,
    "full_get_throughput_ratio_min": 0.8,
    "full_get_cpu_ratio_max": 2.0,
    "resume_ttfb_p95_ratio_max": 2.0,
    "read_amplification_ratio_max": 2.0,
    "read_amplification_additive_mib_max": 1,
    "offline_wall_ratio_max": 3.0,
    "offline_peak_rss_mib_max": 256,
    "replication_bytes_max_multiplier_new_physical": 3.0,
    "replication_bytes_max_percent_live_physical": 5,
    "gix_delta_additional_savings_percentage_points_min": 10,
    "gix_delta_relative_improvement_percent_min": 15,
    "gix_delta_admission_logic": "either threshold may admit the candidate beyond exact semantic CAS",
    "aggressive_delta_additional_savings_percent_min": 15,
    "delta_max_chain_depth": 2,
    "delta_max_reconstructed_unit_mib": 8,
    "hybrid_cache_max_logical_live_percent": 10,
    "hybrid_cache_trace_hit_rate_min_percent": 95,
    "active_memory_per_operation_mib_max": 16,
    "idle_rss_mib_max": 30,
    "idle_rss_ratio_to_flat_max": 2.0,
    "startup_ms_max": 100,
    "startup_p95_ratio_to_flat_max": 2.0,
    "compaction_configured_segments_max": 1,
    "compaction_second_full_cache_copy_allowed": false,
    "dependency_rust_minimum": "1.85",
    "dependency_advisories_max": 0,
    "dependency_report_required": [
      "binary_bytes",
      "closure_bytes",
      "build_seconds",
      "advisories",
      "transitive_crates"
    ],
    "ingest_temporary_space_bounded_required": true,
    "ingest_whole_nar_buffering_allowed": false,
    "backup_restore_verify_required": true,
    "security_auth_and_secret_log_tests_required": true
  },
  "operational_invariants": [
    "No resident database or GC worker.",
    "Verify, GC, recovery, and repack are deterministic offline operations.",
    "Compaction uses one configured segment plus reserve and never a second full-cache copy.",
    "Backup restore into an empty DATA directory passes reconcile and independent Nix verification.",
    "Authorization tests cover read/write capability separation and logs contain no secrets."
  ],
  "corpus_categories_required": 6,
  "corpus_categories_required_improved": 4,
  "corpus_regression_percent_max": 5,
  "stop_rules": [
    "Do not tune thresholds after observing candidate results.",
    "Do not call a quick smoke run decision evidence.",
    "A 25-50 percent result selects the simpler design only when every hard gate passes.",
    "Record host, filesystem, kernel, CPU governor, commit, tool versions, cache state, and exact command."
  ]
}
